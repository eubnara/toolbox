#!/bin/bash
# Monthly reminder for the local KakaoTalk Wine patch (run by kakao-wine-check.timer).
# Notifies when upstream bug 60566 changes state or the system Wine was upgraded.

BUG=60566
PATCHED_WINE=$HOME/opt/wine-randr/bin/wine
SYSTEM_WINE=/opt/wine-stable/bin/wine

system_ver=$("$SYSTEM_WINE" --version 2>/dev/null)
patched_ver=$("$PATCHED_WINE" --version 2>/dev/null)
bug=$(curl -sS -m 30 "https://bugs.winehq.org/rest/bug/$BUG?include_fields=status,resolution" |
      jq -r '.bugs[0] | "\(.status) \(.resolution)"' 2>/dev/null)

msgs=()
case $bug in
    RESOLVED*|CLOSED*|STAGED*)
        msgs+=("Bug $BUG is now: $bug. If the fix is in a released Wine, upgrade and remove the local patch (~/opt/wine-randr/README).") ;;
    "")
        msgs+=("Could not read bug $BUG status: https://bugs.winehq.org/show_bug.cgi?id=$BUG") ;;
esac
if [[ -z $patched_ver ]]; then
    msgs+=("Patched Wine copy ~/opt/wine-randr is missing.")
elif [[ $patched_ver != "$system_ver" ]]; then
    msgs+=("System Wine is ${system_ver:-unknown}, patched copy is $patched_ver: KakaoTalk now runs without the hotplug patch.")
fi

echo "bug $BUG: ${bug:-unknown}; system: ${system_ver:-unknown}; patched: ${patched_ver:-missing}"
for m in "${msgs[@]}"; do
    echo "$m"
    notify-send -a KakaoTalk -i dialog-information "KakaoTalk Wine patch" "$m"
done
